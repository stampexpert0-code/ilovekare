------MultipartBoundary--GKDqBnm8lLZ7vecDYnakIHJEV8IFP1mrMrRHrByMCS----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-7ca7e3fa-cb37-4d31-aa91-adad625daf36@mhtml.blink

@charset "utf-8";

*, ::before, ::after { box-sizing: border-box; }

ul[class], ol[class], button { padding: 0px; }

body, h1, h2, h3, h4, p, ul[class], ol[class], li, figure, figcaption, bloc=
kquote, dl, dd { margin: 0px; }

body { min-height: 100vh; scroll-behavior: smooth; text-rendering: optimize=
speed; line-height: 1.5; }

ul[class], ol[class] { list-style: none; }

a { text-decoration: none; }

a:not([class]) { text-decoration-skip-ink: auto; }

img { max-width: 100%; display: block; }

article > * + * { margin-top: 1em; }

input, button, textarea, select { font: inherit; }

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !=
important; transition-duration: 0.01ms !important; scroll-behavior: auto !i=
mportant; }
}

input[type=3D"number"] { appearance: textfield; }

input, select, input[type=3D"number"]::-webkit-inner-spin-button, input[typ=
e=3D"number"]::-webkit-outer-spin-button { appearance: none; }

html { font-size: 62.5%; }

body { font-family: Lato, arial, sans-serif; font-size: 1.6rem; font-weight=
: 400; }

