Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-f8aae599-05f3-432c-836a-51372339f67b@mhtml.blink

@charset "utf-8";

.gd-ad-flex-parent { animation-name: opacity-bounce; animation-duration: 80=
0ms; animation-delay: 400ms; animation-fill-mode: forwards; animation-timin=
g-function: ease; opacity: 0; }
------MultipartBoundary--TAPMSEgdimgBaQvXNzbCnGAFXQqg7PzpegNLXylhOa----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-7f276ca1-68b1-46ef-bdf7-c0ee983585a8@mhtml.blink

@charset "utf-8";

@keyframes opacity-bounce {=20
